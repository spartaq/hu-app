{
  "title": "A családom – My Family",
  "audio": "/audio/birtoklas/dialogue.mp3",
  "avatarMap": {
    "Anna": "/avatars/anna.png",
    "Béla": "/avatars/bela.png"
  },
  "lines": [
    {
      "speaker": "Anna",
      "text": "Ő az anyám.",
      "translation": "This is my mother.",
      "start": 0,
      "end": 2000
    },
    {
      "speaker": "Béla",
      "text": "És ő az apád?",
      "translation": "And is that your father?",
      "start": 2000,
      "end": 4000
    },
    {
      "speaker": "Anna",
      "text": "Igen, ő az apám. A bátyám is itt van.",
      "translation": "Yes, he is my father. My older brother is here too.",
      "start": 4000,
      "end": 7000
    },
    {
      "speaker": "Béla",
      "text": "Az öcsém új kabátja nagyon tetszik.",
      "translation": "I like my younger brother’s new coat.",
      "start": 7000,
      "end": 10000
    },
    {
      "speaker": "Anna",
      "text": "A nővérem cipője fekete.",
      "translation": "My sister's shoes are black.",
      "start": 10000,
      "end": 13000
    }
  ]
}
