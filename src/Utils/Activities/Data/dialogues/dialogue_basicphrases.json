{
  "type": "dialogue",
  "title": "Morning Greeting",
  "data": {
    "audio": "/Audio/Ujszomszedok.mp3",
    "avatarMap": {
      "Anna": "/avatars/anna.png",
      "Béla": "/avatars/bela.png"
    },
    "lines": [
      {
        "speaker": "Anna",
        "text": "Jó reggelt!",
        "translation": "Good morning!",
        "start": 0,
        "end": 3000
      },
      {
        "speaker": "Béla",
        "text": "Jó reggelt kívánok! Hogy vagy?",
        "translation": "Good morning! How are you?",
        "start": 3001,
        "end": 6000
      },
      {
        "speaker": "Anna",
        "text": "Köszönöm, jól. És te?",
        "translation": "Thanks, I’m good. And you?",
        "start": 6001,
        "end": 9000
      },
      {
        "speaker": "Béla",
        "text": "Én is jól vagyok. Szép napot!",
        "translation": "I’m good too. Have a nice day!",
        "start": 9001,
        "end": 12000
      }
    ]
  }
}