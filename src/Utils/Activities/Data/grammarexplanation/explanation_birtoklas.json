{
  "type": "grammarexplanation",
  "title": "Hungarian Possessive Forms – Quick Guide",
  "data": {
    "type": "explanation",
    "sections": [
      {
        "heading": "Showing Possession",
        "paragraphs": [
          "Hungarian shows possession by adding endings to nouns instead of using separate words like 'my' or 'your'."
        ],
        "list": [
          "Könyvem – my book (Én)",
          "Könyved – your book (Te)",
          "Könyve – his/her book (Ő)",
          "Könyvünk – our book (Mi)",
          "Könyvetek – your book (Ti)",
          "Könyvük – their book (Ők)"
        ]
      },
      {
        "heading": "Plural Possessive (more than one item)",
        "paragraphs": [
          "For plural nouns, add -k first, then apply the possessive endings."
        ],
        "list": [
          "Könyveim – my books (Én)",
          "Könyveid – your books (Te)",
          "Könyvei – his/her books (Ő)",
          "Könyveink – our books (Mi)",
          "Könyveitek – your books (Ti)",
          "Könyveik – their books (Ők)"
        ]
      }
    ]
  }
}
